# ==========================================
# 1. Conexión con el Backend
# ==========================================

VITE_API_URL=http://localhost:3000/api

# ==========================================
# 2. Autenticación (Fase 1: Auth0)
# ==========================================
# Mismo dominio configurado en Auth0
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com

# Client ID de la SPA (Single Page Application) creada en Auth0
VITE_AUTH0_CLIENT_ID=tu_client_id_de_auth0

# Audience de la API para solicitar access tokens válidos para tu backend
VITE_AUTH0_AUDIENCE=https://api.concesionaria.com/

# ==========================================
# 3. Datos de Contacto y Redes
# ==========================================
# Número de WhatsApp para el CTA (formato internacional sin espacios ni signos, ej: 5491112345678)
VITE_WHATSAPP_PHONE=5491112345678

# Enlaces a Redes Sociales (pueden ser variables o fijas en el componente)
VITE_INSTAGRAM_URL=https://instagram.com/tuconcesionaria
VITE_FACEBOOK_URL=https://facebook.com/tuconcesionaria

# ==========================================
# 4. Autenticación (Fase 2: Keycloak - Opcional / Futuro)
# ==========================================
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=concesionaria-realm
# VITE_KEYCLOAK_CLIENT_ID=concesionaria-frontend