# ==========================================
# 1. Configuración del Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 2. Seguridad y CORS
# ==========================================
# URL permitida del frontend para realizar peticiones 
CLIENT_URL=http://localhost:5173

# ==========================================
# 3. Base de Datos (Prisma ORM)
# ==========================================
# Formato para PostgreSQL (Local, Neon.tech o Supabase):
# postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/concesionaria_db?schema=public"


# ==========================================
# 4. Autenticación (Fase 1: Auth0)
# ==========================================
# Dominio de tu tenant en Auth0 (ej: dev-xyz.us.auth0.com)
AUTH0_DOMAIN=tu-tenant.us.auth0.com

# Identificador / Audience de la API registrada en Auth0
AUTH0_AUDIENCE=https://api.concesionaria.com/

# ==========================================
# 5. Autenticación (Fase 2: Keycloak - Opcional / Futuro)
# ==========================================
# URL base del servidor de Keycloak
# KEYCLOAK_SERVER_URL=http://localhost:8080
# KEYCLOAK_REALM=concesionaria-realm
# KEYCLOAK_CLIENT_ID=concesionaria-backend