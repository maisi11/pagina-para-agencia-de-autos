# ==========================================
# 1. Configuración del Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# 2. Seguridad y CORS
# ==========================================
# URL permitida del frontend para realizar peticiones 
CLIENT_URL=http://localhost:5173

# ==========================================
# 3. Base de Datos (Prisma ORM)
# ==========================================
# Se requiere PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"


# ==========================================
# 4. Autenticación
# ==========================================
# Dominio de tu tenant en Auth0 (ej: dev-xyz.us.auth0.com)
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE= "Link de la api ej: https://nombreapi.com/"
# ==========================================
# 5. Autenticación (Fase 2: Keycloak - Opcional / Futuro)
# ==========================================
# URL base del servidor de Keycloak
# KEYCLOAK_SERVER_URL=http://localhost:8080
# KEYCLOAK_REALM=concesionaria-realm
# KEYCLOAK_CLIENT_ID=concesionaria-backend